{
  "name": "reactris-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "engine",
    "web",
    "cli"
  ],
  "scripts": {
    "build:engine": "npm -w @reactris/engine run build",
    "web": "npm -w @reactris/web start",
    "test": "npm -w @reactris/web test -- --watchAll=false",
    "cli": "npm -w @reactris/cli start",
    "build": "npm -w @reactris/engine run build && npm -w @reactris/web run build"
  }
}
