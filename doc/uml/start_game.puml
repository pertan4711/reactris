@startuml start_game
!theme mars
skinparam Style strictuml

actor "Player" as Player #green
participant "Front-end\n(UseGameState / CLI loop)" as Front #green
participant "playGroundModel" as Playground #blue
participant "Active block" as Block #orange
participant "Wall" as Wall #red

Player -[#blue]> Front : start game
Front -[#blue]> Playground : reset()
Playground -[#red]> Wall : reset(initWallHeight)
Playground -[#orange]> Block : generateBlock() (active + next)

loop every intervalForLevel(level) ms
    Front -[#blue]> Playground : tick()
    Playground -[#orange]> Block : move down
    alt No collision
        Playground -> Playground : keep falling
    else Block collision
        Playground -[#red]> Wall : addBlock(activeBlock)
        Playground -[#orange]> Block : activeBlock = nextActive,\nnextActive = generateBlock()
        opt New block collides
            Playground -> Playground : gameover = true
        end
        Playground -[#red]> Wall : check4CompletedRows()
        Wall -[#red]> Wall : delete full rows
        Wall --> Playground : rows cleared
        Playground -> Playground : update score and level
    end
    Front -> Front : re-render from model
end

Player -[#blue]> Front : key press
alt Left / right
    Front -[#blue]> Playground : tryMove(-1 | 1)
else Rotate
    Front -[#blue]> Playground : tryRotate("left" | "right")
else Down
    Front -[#blue]> Playground : softDrop()
end
Playground --> Front : move undone if it collides

@enduml
